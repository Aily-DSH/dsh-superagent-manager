{
  "name": "dsh-superagent-manager",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "description": "Manage dsh-superagent projects from one DSH client: create the repository, clone, sidebar Workspace and Super Agent instance, then run and proxy every instance in a tabbed panel.",
  "license": "MIT",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aily-DSH/dsh-superagent-manager.git"
  },
  "homepage": "https://github.com/Aily-DSH/dsh-superagent-manager#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "superagent"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  }
}
